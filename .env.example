# --- MySQL ---
MYSQL_URL=jdbc:mysql://localhost:3306/gestion
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# --- JWT ---
# El secret tiene que ser largo: HS256 necesita al menos 256 bits (32 caracteres).
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- CORS ---
# Origenes permitidos separados por comas (en produccion usar el dominio del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MinIO ---
MINIO_URL=http://localhost:9000
MINIO_BUCKET=gestionbucket
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Usuario admin (SUDO) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
