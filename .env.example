# Credenciales del backend.
#
# Spring Boot no lee este archivo solo: hay que exportarlo antes de arrancar
# la app (ver README) o cargarlo con spring.config.import.
#
# Copiá este archivo a .env, completá los valores y NO commitees el .env.

# --- MySQL ---
MYSQL_URL=jdbc:mysql://localhost:3306/gestion
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# --- JWT ---
# El secret tiene que ser largo: HS256 necesita al menos 256 bits (32 caracteres).
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- MinIO ---
MINIO_URL=http://localhost:9000
MINIO_BUCKET=gestionbucket
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Usuario admin (SUDO) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
