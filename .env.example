# --- Perfil ---
# "dev" habilita defaults de desarrollo (credenciales locales, logs DEBUG, cookie sin Secure,
# CORS a http://localhost:5173). Sin perfil, las variables marcadas como OBLIGATORIA tienen que estar
# definidas o la app no arranca.
SPRING_PROFILES_ACTIVE=dev

# --- MySQL (OBLIGATORIA sin perfil dev) ---
MYSQL_URL=jdbc:mysql://localhost:3306/gestion
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# --- JWT ---
# OBLIGATORIA sin perfil dev. HS256 necesita al menos 256 bits: minimo 32 caracteres.
JWT_SECRET=
# vida del token en ms (default 12 h). La cookie de sesion vence junto con el token.
JWT_EXPIRATION=43200000

# --- Cookie de sesion ---
# true salvo en local sin TLS (el perfil dev ya la pone en false)
COOKIE_SECURE=true
# Lax si front y back comparten sitio; None si estan en dominios distintos (exige COOKIE_SECURE=true)
COOKIE_SAME_SITE=Lax

# --- CORS ---
# origenes del front separados por coma. Sin valor no se habilita CORS (salvo el default del perfil dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limit del login (cache en memoria, por instancia) ---
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_RATE_LIMIT_WINDOW=15m

# --- Reverse proxy ---
# native/framework detras de un proxy con TLS (IP real del cliente y esquema https); none si no hay proxy
FORWARD_HEADERS_STRATEGY=none

# --- MinIO (OBLIGATORIA sin perfil dev; docker-compose.yml tambien las lee de este archivo) ---
MINIO_URL=http://localhost:9000
MINIO_BUCKET=gestionbucket
MINIO_ACCESS_KEY=
# minimo 8 caracteres (requisito de MinIO)
MINIO_SECRET_KEY=

# --- Usuario admin (SUDO) ---
# Si faltan email o password no se crea el SUDO inicial. Password: 8 a 72 caracteres.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
